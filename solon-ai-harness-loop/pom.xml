<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.noear</groupId>
        <artifactId>solon-ai-parent</artifactId>
        <version>4.2.0-SNAPSHOT</version>
        <relativePath>../solon-ai-parent/pom.xml</relativePath>
    </parent>

    <artifactId>solon-ai-harness-loop</artifactId>
    <name>${project.artifactId}</name>
    <packaging>jar</packaging>
    <description>solon-ai-harness 插件：会话定时任务（/loop；间隔/cron 调度、loop_* 模型工具、tasks.json 持久化）</description>

    <dependencies>
        <!-- 只依赖核心契约（HarnessExtension / SessionStatus / ErrorClassifier），不依赖其它插件 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai-harness-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-scheduling-simple</artifactId>
        </dependency>

        <!-- cron 预校验（与 solon-scheduling-simple 内部同一解析器；插件直接使用，故显式声明） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>java-cron</artifactId>
            <version>${java-cron.version}</version>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试工具（i18n 覆盖率/lint/golden）：由 solon-ai-testkit 提供（内部模块，不发布） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 测试替身（command.builtin.Fakes）：由 solon-ai-harness-testkit 提供（内部模块，不发布） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai-harness-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
